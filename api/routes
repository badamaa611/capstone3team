import pandas as pd
import requests
from io import StringIO
from flask import Blueprint, render_template, request, jsonify, flash, redirect, url_for
from flask_login import login_required, current_user

main = Blueprint('main', __name__)

# Таны Google Sheet-ийн CSV хэлбэрээр татах линк
SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/1HkJZUebgNFtYghS55KUKcCjNVx7A4O2huEvyv1d331o/export?format=csv&gid=830552134"

def convert_imgbb_url(url):
    """
    ImgBB-ийн энгийн линкийг Flask дээр шууд харагдах 
    жинхэнэ зургийн линк рүү хөрвүүлэх функц
    """
    if not url or pd.isna(url):
        return None
    
    url = str(url).strip()
    
    # Хэрэв хэрэглэгч ibb.co гэсэн богино линк оруулсан бол хөрвүүлнэ
    # Жишээ нь: https://ibb.co/xyz123 -> https://i.ibb.co/xyz123/image.png
    if "ibb.co" in url and "i.ibb.co" not in url:
        # Линкийн төгсгөл дэх ID-г салгаж авах
        parts = url.rstrip('/').split('/')
        img_id = parts[-1]
        # ImgBB-ийн шууд зургийн бүтэц рүү шилжүүлэх
        return f"https://i.ibb.co/{img_id}/image.png"
        
    return url

@main.route('/dashboard')
@login_required
def dashboard():
    # Frontend-ээс ирж буй анги, хичээлийн мэдээллийг авах
    angi = request.args.get('angi')
    hicheel = request.args.get('hicheel')
    
    if not angi or not hicheel:
        flash("Анги болон хичээл сонгогдоогүй байна!")
        return redirect(url_for('main.index'))
        
    try:
        # Google Sheet-ээс өгөгдлийг шууд унших
        response = requests.get(SHEET_CSV_URL)
        response.encoding = 'utf-8'
        
        # Pandas-аар DataFrame үүсгэх
        df = pd.read_csv(StringIO(response.text))
        
        # Баганын нэрсийг цэвэрлэх (зайг устгах)
        df.columns = [c.strip() for c in df.columns]
        
        # Сонгосон анги болон хичээлээр шүүлтүүр хийх
        filtered_df = df[
            (df['Анги'].astype(str) == str(angi)) & 
            (df['Хичээл'].str.strip().str.lower() == str(hicheel).strip().str.lower())
        ]
        
        # Бүх асуултыг жагсаалт болгож хөрвүүлэх
        questions = []
        for idx, row in filtered_df.iterrows():
            raw_image_url = row.get('Зураг', None)
            
            # Ирж буй линкийг ImgBB-ийн шууд линк рүү хөрвүүлэх функцийг ажиллуулах
            final_image_url = convert_imgbb_url(raw_image_url)

            questions.append({
                'id': idx,
                'question_text': row.get('Асуулт', ''),
                'image_url': final_image_url, # Зассан линкийг энд оноож байна
                'opt_a': row.get('А', ''),
                'opt_b': row.get('Б', ''),
                'opt_c': row.get('В', ''),
                'opt_d': row.get('Г', ''),
                'correct': str(row.get('Зөв хариулт', '')).strip().upper()
            })
            
        return render_template('quiz.html', questions=questions, angi=angi, hicheel=hicheel)
        
    except Exception as e:
        print(f"Алдаа гарлаа: {e}")
        return f"Google Sheet-ээс өгөгдөл уншихад алдаа гарлаа: {str(e)}", 500